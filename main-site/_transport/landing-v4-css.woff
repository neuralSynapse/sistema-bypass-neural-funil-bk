block;width:100%;margin:0 0 9px;padding:5px;border:1px solid rgba(210,163,74,.16);border-radius:11px;background:#0a0907;cursor:pointer;break-inside:avoid}.testimonial img{display:block;width:100%;border-radius:7px}.disclaimer{text-align:center;color:var(--muted2);font-size:8px}.offer{background:radial-gradient(circle at 70% 50%,rgba(210,163,74,.08),transparent 28%)}.offer-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:24px;align-items:center;max-width:1000px}.offer-grid>div:first-child p{color:var(--muted)}.offer-grid ul{display:grid;grid-template-columns:1fr 1fr;gap:7px 14px;padding:0;list-style:none}.offer-grid li{font-size:10px;padding-left:16px;position:relative}.offer-grid li:before{content:'✓';position:absolute;left:0;color:var(--gold2)}.price{padding:25px;border:1px solid rgba(210,163,74,.38);border-radius:21px;background:linear-gradient(#141009,#090806);text-align:center;box-shadow:var(--shadow)}.price>span{font-size:8px;letter-spacing:.18em;color:var(--gold);font-weight:900}.price>strong{display:block;font-family:'Barlow Condensed';font-size:96px;line-height:.85;color:var(--gold2);margin:15px 0 6px}.price>strong small{font-size:21px}.price p{font-size:11px;color:var(--muted)}.price .btn{width:100%;margin:10px 0}.price>small{display:block;color:var(--muted2);font-size:8px}.guarantee{background:#0a0907;border-block:1px solid rgba(210,163,74,.08)}.guarantee-grid{display:grid;grid-template-columns:125px 1fr;gap:25px;align-items:center;max-width:900px}.seven{display:flex;flex-direction:column;align-items:center;justify-content:center;width:115px;height:115px;border-radius:50%;border:1px solid var(--gold)}.seven b{font-family:'Barlow Condensed';font-size:54px;color:var(--gold2);line-height:.8}.seven span{font-size:9px;letter-spacing:.2em;color:var(--gold);margin-top:8px}.guarantee-grid p{color:var(--muted);font-size:12px}.faq details{padding:16px 0;border-top:1px solid rgba(210,163,74,.12)}.faq details:last-of-type{border-bottom:1px solid rgba(210,163,7