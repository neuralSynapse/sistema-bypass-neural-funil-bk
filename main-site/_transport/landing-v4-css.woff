x-width:1050px){.nav nav{display:none}.hero-grid{grid-template-columns:1fr}.hero-copy{text-align:center}.watch{justify-content:center}.hero-product{max-width:820px;margin:auto}.pain-grid{grid-template-columns:repeat(2,1fr)}.steps{grid-template-columns:repeat(3,1fr)}.member-dashboard{grid-template-columns:180px 1fr}.dash-cards{grid-template-columns:repeat(2,1fr)}.course-showcase,.course-showcase.reverse{grid-template-columns:1fr}.journey{grid-template-columns:repeat(4,1fr)}.journey article:nth-child(4):after{display:none}.arsenal{grid-template-columns:repeat(4,1fr)}.vault{grid-template-columns:repeat(3,1fr)}.authority-grid{grid-template-columns:1fr}.photo{max-width:470px;width:100%;margin:auto;min-height:560px}.authority-copy{padding-top:22px}.metrics{grid-template-columns:repeat(3,1fr)}.offer-grid{grid-template-columns:1fr}}@media(max-width:680px){.wrap{width:min(var(--max),calc(100% - 24px))}.section{padding:38px 0}.section-sm{padding:31px 0}.nav{height:60px}.brand i{width:36px;height:36px}h1{font-size:47px}.lead{font-size:16px}.muted{font-size:11px}.sound>span{width:58px;height:58px}.after-video .btn{width:100%;font-size:11px;min-height:54px}.pain-grid{grid-template-columns:1fr}.pain-grid article{min-height:auto}.diag{grid-template-columns:1fr;gap:10px;text-align:center}.steps{grid-template-columns:1fr 1fr}.steps article:last-child{grid-column:1/-1}.op{grid-template-columns:55px 1fr;padding:14px}.op>strong{width:50px;height:50px;font-size:27px}.member-dashboard{grid-template-columns:1fr}.dash-sidebar{border-right:0;border-bottom:1px solid rgba(210,163,74,.16);display:grid;grid-template-columns:repeat(2,1fr)}.dash-logo,.dash-sidebar>b{grid-column:1/-1}.dash-main{padding:15px}.dash-top{display:block}.gold-pill{display:inline-block;margin-top:10px}.dash-cards{grid-template-columns:1fr 1fr}.proof-strip{grid-template-columns:1fr}.subheading{grid-template-columns:42px 1fr;margin-top:30px}.subheading>span{width:42px;height:42px}.subheading h2{font-size:31px}.course-showcase,.course-showcase.reverse{padding:12px}.course-copy{text-align:center}.course-showcase.reverse .course-copy{order:2}.course-showcase.reverse .course-image{order:1}.journey{grid-template-columns:1fr 1fr}.journey article:nth-child(even):after{display:none}.journey article{min-height:215px}.arsenal{grid-template-columns:1fr 1fr}.vault{grid-template-columns:1fr 1fr}.vault article:last-child{grid-column:1/-1}.photo{min-height:500px}.authority-copy{text-align:center;padding:25px 18px}.authority-copy h2{font-size:52px}.authority-lead{font-size:16px!important}.metrics{grid-template-columns:1fr 1fr}.metrics span:last-child{grid-column:1/-1}.offer-grid>div:first-child{text-align:center}.offer-grid ul{grid-template-columns:1fr;text-align:left}.price>strong{font-size:84px}.guarantee-grid{grid-template-columns:1fr;text-align:center;justify-items:center}.foot{flex-direction:column;text-align:center;align-items:center}.cookies{grid-template-columns:1fr}.cookies div{width:100%}.cookies button{flex:1}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}