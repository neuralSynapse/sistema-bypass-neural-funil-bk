:root{--bg:#060605;--bg2:#0b0906;--panel:#0e0c08;--panel2:#141008;--text:#f5f0e7;--muted:#b8afa0;--muted2:#7f7566;--gold:#d2a34a;--gold2:#f0d18a;--gold3:#8e6727;--gold4:#fff0b7;--line:rgba(210,163,74,.28);--line2:rgba(255,255,255,.07);--max:1180px;--shadow:0 26px 80px rgba(0,0,0,.48)}*{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--bg)}body{margin:0;background:radial-gradient(circle at 50% -10%,rgba(210,163,74,.11),transparent 28%),linear-gradient(#070706,#050504);color:var(--text);font-family:Manrope,sans-serif;line-height:1.55;overflow-x:hidden}img{max-width:100%;height:auto}a{color:inherit}.wrap{width:min(var(--max),calc(100% - 36px));margin:auto}.narrow{max-width:930px}.section{padding:58px 0}.section-sm{padding:42px 0}.top{position:sticky;top:0;z-index:100;background:rgba(6,6,5,.88);backdrop-filter:blur(18px);border-bottom:1px solid rgba(210,163,74,.13)}.nav{height:66px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:10px;text-decoration:none}.brand i{display:grid;place-items:center;width:40px;height:40px;border:1px solid var(--line);border-radius:50%;color:var(--gold2);font-family:Georgia;font-style:normal;font-size:13px;background:radial-gradient(circle,rgba(210,163,74,.1),transparent 65%)}.brand span{display:grid;line-height:.83}.brand small{font-size:8px;letter-spacing:.34em;color:#ddd}.brand b{font-family:'Barlow Condensed';font-size:23px;letter-spacing:.08em;color:var(--gold2)}.brand em{font-size:8px;letter-spacing:.43em;color:var(--gold);font-style:normal}.nav nav{display:flex;gap:22px}.nav nav a{text-decoration:none;font-size:11px;font-weight:700;color:var(--muted)}.nav nav a:hover{color:var(--gold2)}h1,h2,h3,h4{font-family:'Barlow Condensed',sans-serif;text-transform:uppercase;margin-top:0}h1{font-size:clamp(43px,5.6vw,74px);line-height:.94;letter-spacing:-.025em;margin-bottom:20px}h2{font-size:clamp(32px,4vw,52px);line-height:1;letter-spacing:-.02em;margin-bottom:13px}h3{font-size:27px;line-height:1.03;margin-bottom:9px}h4{font-size:21px;line-height:1.03;margin-bottom:7px}mark{background:none;color:var(--gold2)}.eyebrow{color:var(--gold2);font-size:10px;font-weight:900;letter-spacing:.18em;margin-bottom:11px}.heading{text-align:center;max-width:850px;margin:0 auto 24px}.heading p{max-width:720px;margin:9px auto 0;color:var(--muted);font-size:13px}.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:38px;align-items:center}.lead{font-size:19px;color:#ded6cb;max-width:670px;margin:0 0 14px}.muted{color:var(--muted);font-size:12px;max-width:650px}.watch{display:flex;align-items:center;gap:8px;margin-top:20px;font-size:10px;color:#c7bcad;font-weight:700}.watch span{width:8px;height:8px;border-radius:50%;background:var(--gold);box-shadow:0 0 18px rgba(210,163,74,.55)}.hero-product{border:1px solid var(--line);border-radius:23px;background:#090806;padding:0;overflow:hidden;cursor:pointer;box-shadow:var(--shadow)}.hero-product img{display:block;width:100%}.vsl{padding-top:22px}.video{position:relative;aspect-ratio:16/9;background:#000;border:1px solid rgba(210,163,74,.4);border-radius:19px;overflow:hidden;box-shadow:var(--shadow)}#youtubePlayer,#youtubePlayer iframe{position:absolute;inset:0;width:100%;height:100%;border:0}.sound{position:absolute;inset:0;z-index:5;border:0;cursor:pointer;color:white;background:radial-gradient(circle,rgba(210,163,74,.18),rgba(0,0,0,.86));display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;padding:25px;transition:.25s}.sound.hidden{opacity:0;pointer-events:none}.sound>span{display:grid;place-items:center;width:70px;height:70px;border-radius:50%;background:linear-gradient(135deg,#f1ce83,#8e6727);color:#0b0905;font-size:24px;padding-left:4px;box-shadow:0 0 45px rgba(210,163,74,.4)}.sound strong{font-family:'Barlow Condensed';font-size:clamp(24px,3vw,37px);letter-spacing:.04em}.sound small{color:#d8d0c5;max-width:500px}.loading{position:absolute;left:14px;bottom:11px;z-index:4;font-size:10px;color:#958982}.after-video{margin-top:12px;display:flex;flex-direction:column;align-items:center;gap:8px}.after-video p{margin:0;color:var(--muted);font-size:11px}.btn{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;min-height:58px;padding:0 28px;border-radius:12px;font-weight:900;font-size:13px;background:linear-gradient(135deg,#f0d18a,#b8842e);border:1px solid #f3d894;color:#100c05;box-shadow:0 14px 40px rgba(210,163,74,.19);transition:.2s}.btn:hover{transform:translateY(-2px);filter:brightness(1.05)}.pain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.pain-grid article{padding:19px;border:1px solid var(--line2);border-radius:15px;background:linear-gradient(180deg,#11100c,#090806);min-height:175px}.pain-grid i{display:grid;place-items:center;width:40px;height:40px;border:1px solid rgba(210,163,74,.35);border-radius:11px;font-style:normal;color:var(--gold2);font-weight:900;background:rgba(210,163,74,.05);margin-bottom:12px}.pain-grid h3{font-size:20px}.pain-grid p{margin:0;color:var(--muted);font-size:11px}.diagnosis{background:linear-gradient(90deg,rgba(210,163,74,.08),rgba(210,163,74,.015));border-block:1px solid rgba(210,163,74,.1)}.diag{display:grid;grid-template-columns:.9fr 1.1fr;gap:38px;align-items:center}.diag h2{margin:0}.diag>p{margin:0;color:#d7cfc3;font-size:16px}.steps{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}.steps article{padding:18px 16px;border:1px solid var(--line2);border-radius:14px;background:linear-gradient(#100e0a,#090806)}.steps article>b{display:grid;place-items:center;width:29px;height:29px;border-radius:50%;background:rgba(210,163,74,.09);border:1px solid rgba(210,163,74,.3);color:var(--gold2);font-size:10px}.steps h3{font-size:20px;margin:11px 0 5px}.steps p{margin:0;color:var(--muted);font-size:11px}.op{margin-top:13px;display:grid;grid-template-columns:70px 1fr;gap:17px;align-items:center;padding:17px 20px;border:1px solid var(--line);border-radius:15px;background:linear-gradient(90deg,#121008,#090806)}.op>strong{display:grid;place-items:center;width:61px;height:61px;border-radius:50%;border:1px solid var(--gold);font-family:'Barlow Condensed';font-size:31px;color:var(--gold2)}.op span{font-size:9px;color:var(--gold);font-weight:900;letter-spacing:.15em}.op h3{margin:1px 0 3px;font-size:23px}.op p{margin:0;color:var(--muted);font-size:11px}.inside{background:radial-gradient(circle at 50% 5%,rgba(210,163,74,.08),transparent 32%),#070706;border-block:1px solid rgba(210,163,74,.09)}.inside-heading{margin-bottom:30px}.member-dashboard{display:grid;grid-template-columns:220px 1fr;border:1px solid rgba(210,163,74,.35);border-radius:22px;overflow:hidden;background:linear-gradient(145deg,#0d0b07,#070706);box-shadow:var(--shadow)}.dash-sidebar{padding:22px 15px;border-right:1px solid rgba(210,163,74,.16);display:flex;flex-direction:column;gap:5px;background:linear-gradient(180deg,#100d07,#080706)}.dash-logo{width:48px;height:48px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;font-family:Georgia;color:var(--gold2);margin-bottom:6px}.dash-sidebar>b{font-family:'Barlow Condensed';text-transform:uppercase;font-size:21px;margin-bottom:10px}.dash-sidebar span{padding:9px 10px;border-radius:9px;color:#a99e8d;font-size:10px}.dash-sidebar span.active{color:#130e05;background:linear-gradient(135deg,#f0d18a,#a97827);font-weight:900}.dash-main{padding:25px}.dash-top{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:18px}.dash-top small{color:var(--gold);font-size:8px;letter-spacing:.16em;font-weight:900}.dash-top h3{font-size:31px;margin:5px 0 0}.gold-pill{padding:7px 9px;border-radius:999px;border:1px solid var(--line);color:var(--gold2);font-size:8px;font-weight:900;letter-spacing:.12em}.dash-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.dash-cards article{padding:15px;border:1px solid rgba(255,255,255,.07);border-radius:12px;background:linear-gradient(180deg,#11100c,#0a0907);min-height:130px}.dash-cards i{display:grid;place-items:center;width:35px;height:35px;border:1px solid var(--line);border-radius:10px;color:var(--gold2);font-family:'Barlow Condensed';font-style:normal;font-size:13px;margin-bottom:11px}.dash-cards b{display:block;font-size:11px}.dash-cards span{display:block;color:var(--muted);font-size:8px;margin-top:4px}.proof-strip{display:grid;grid-template-columns:.6fr 1.4fr;gap:18px;align-items:center;margin-top:13px;padding:14px;border:1px solid rgba(255,255,255,.06);border-radius:16px;background:#0a0907}.proof-img{padding:0;border:0;background:#060605;border-radius:11px;overflow:hidden;cursor:pointer}.proof-img img{display:block;width:100%}.tag{display:inline-block;padding:6px 9px;border-radius:999px;border:1px solid rgba(210,163,74,.32);background:rgba(210,163,74,.05);color:var(--gold2);font-size:8px;font-weight:900;letter-spacing:.14em}.proof-strip h3{font-size:25px;margin:8px 0 5px}.proof-strip p{font-size:10px;color:var(--muted);margin:0}.subheading{display:grid;grid-template-columns:50px 1fr;gap:13px;align-items:center;margin:38px 0 16px}.subheading>span{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;border:1px solid var(--gold);font-family:'Barlow Condensed';font-size:20px;color:var(--gold2)}.subheading .eyebrow{margin:0 0 4px}.subheading h2{font-size:37px;margin:0}.course-showcase{display:grid;grid-template-columns:1.05fr .95fr;gap:20px;align-items:center;padding:17px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(135deg,#0f0d09,#080706);margin-bottom:11px}.course-showcase.reverse{grid-template-columns:.95fr 1.05fr}.course-image{padding:0;border:0;border-radius:13px;overflow:hidden;cursor:pointer;background:#070706}.course-image img{display:block;width:100%}.course-copy{padding:10px}.course-copy h3{font-size:34px;margin:9px 0}.course-copy p{font-size:11px;color:var(--muted);margin:7px 0}.course-copy b{color:var(--gold2)}.j